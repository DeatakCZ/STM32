void LatchData()
{
	HAL_GPIO_WritePin(TIM_LATCH_GPIO_Port, TIM_LATCH_Pin, GPIO_PIN_RESET);
	HAL_Delay(1);			// needs 24ns at 4,5V
	HAL_GPIO_WritePin(TIM_LATCH_GPIO_Port, TIM_LATCH_Pin, GPIO_PIN_SET);
	HAL_Delay(1);
}

void ReadData(uint8_t Byte1, uint8_t Byte2)
{
	LatchData();

	Byte1 = 0x00;
	Byte2 = 0x00;

	for(uint8_t i = 0 ; i < 8 ; i++)
	{
		if(i < 4)
		{
			Byte1 = Byte1 << 1;
			if(HAL_GPIO_ReadPin(TIM_DATA_GPIO_Port, TIM_DATA_Pin) == 1)
			{
				Byte1 |= 0x01;
			}
			else
			{
				asm("NOP");
				asm("NOP");
			}
		}
		else if(i>=4)
		{
			Byte2 = Byte2 << 1;
			if(HAL_GPIO_ReadPin(TIM_DATA_GPIO_Port, TIM_DATA_Pin) == 1)
			{
				Byte2 |= 0x01;
			}
			else
			{
				asm("NOP");
				asm("NOP");
			}
		}



		HAL_GPIO_WritePin(TIM_CLOCK_GPIO_Port, TIM_CLOCK_Pin, GPIO_PIN_SET);
		HAL_Delay(1);

		HAL_GPIO_WritePin(TIM_CLOCK_GPIO_Port, TIM_CLOCK_Pin, GPIO_PIN_RESET);
		HAL_Delay(1);

	}
}

void CalculateDelay()
{
	Rel1_Timer = 0;
	Rel2_Timer = 0;

	Rel1_Timer = DIP1 * TIMER_MULTIPLIER;
	Rel2_Timer = DIP2 * TIMER_MULTIPLIER;
}
