/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_TIM2_Init();

  /* Initialize interrupts */
  MX_NVIC_Init();
  /* USER CODE BEGIN 2 */

  //HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

//////////////////////////////////////////////////
// Fill array with 0's
  for(i = 0 ; i < NEOPIXEL_NUMBER ; i++)
  {
	  for(j = 0 ; j < 3 ; j++)
	  {
		  switch(j){
		  case 0:	//Green
			  pixel[i].color.G = 0;
			  break;
		  case 1:	//Red
			  pixel[i].color.R = 0;
			  break;
		  case 2:	//Blue
			  pixel[i].color.B = 0;
			  break;
		  }
	  }
  }

//////////////////////////////////////////////////


	while (1)
	{

		if(l>14)
			l=0;
		else
			l++;



//////////////////////////////////////////////////
// Fill array with values
		for(n = 0 ; n < 255 ; n++)							//Cycles
		{
			for(i = 0 ; i < NEOPIXEL_NUMBER ; i++)			// Separate LEDs
			{
				for(j = 0 ; j < 3 ; j++)					//Separate colours
				{
					switch(j)
					{
					case 0:	//Green
						pixel[i].color.G = Constrain((n + GreenAdvance + (i * LEDAdvance)), 0, 255);
						break;
					case 1:	//Red
						pixel[i].color.R = Constrain((n + RedAdvance + LEDAdvance), 0, 255);
						break;
					case 2:	//Blue
						pixel[i].color.B = Constrain((n + BlueAdvance + LEDAdvance), 0, 255);;
						break;
					}
				}
			}
		}
//////////////////////////////////////////////////


//////////////////////////////////////////////////
// Write values into DMA buffer
//	G7-G0,R7-R0,B7-B0
	for (i = 0; i < NEOPIXEL_NUMBER; i++)			//Separate LEDs
	{
		for(j = 0 ; j < 3 ; j++)					//Separate colours
		{
			for(k = 8 ; k > 0 ; k--)					//Separate bits in value
			{
				switch(j)
				{
				case 0:	//Green
					if ((pixel[i].color.G >> (k - 1)) & 0x01)
					{
						dmaBuffer[(i*24) + (j*8) + (8-k)] = NEOPIXEL_ONE;		// 24 bits per LED ; 8 bits per colours ; Big Endian of colour
					}
					else
					{
						dmaBuffer[(i*24) + (j*8) + (8-k)] = NEOPIXEL_ZERO;
					}
					break;
				case 1:	//Red
					if ((pixel[i].color.R >> (k - 1)) & 0x01)
					{
						dmaBuffer[(i*24) + (j*8) + (8-k)] = NEOPIXEL_ONE;		// 24 bits per LED ; 8 bits per colours ; Big Endian of colour
					}
					else
					{
						dmaBuffer[(i*24) + (j*8) + (8-k)] = NEOPIXEL_ZERO;
					}
					break;
				case 2:	//Blue
					if ((pixel[i].color.B >> (k - 1)) & 0x01)
					{
						dmaBuffer[(i*24) + (j*8) + (8-k)] = NEOPIXEL_ONE;		// 24 bits per LED ; 8 bits per colours ; Big Endian of colour
					}
					else
					{
						dmaBuffer[(i*24) + (j*8) + (8-k)] = NEOPIXEL_ZERO;
					}
					break;
				}
			}
		}
	}
//////////////////////////////////////////////////


//////////////////////////////////////////////////
// Write DMA Buffer into Timer to generate correct PWM
	for(k = 0 ; k < 11 ; k++)
	{
		dmaBuffer[DMA_BUFF_SIZE - 1] = 0; // last element must be 0!
	}
		HAL_TIM_PWM_Start_DMA(&htim2, TIM_CHANNEL_1, dmaBuffer, DMA_BUFF_SIZE);

		HAL_Delay(10);
//////////////////////////////////////////////////


    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	}
  /* USER CODE END 3 */
}

