  98:Core/Src/main.c ****   // ============================================================================
  99:Core/Src/main.c ****   // WS2812B TIMER-BASED LED STRIP INITIALIZATION
 100:Core/Src/main.c ****   // ============================================================================
 101:Core/Src/main.c ****   // Uses Timer2 PWM on GPIO A0 for precise WS2812B timing
 102:Core/Src/main.c ****   // 
 103:Core/Src/main.c ****   // BRIGHTNESS CONFIGURATION:
 104:Core/Src/main.c ****   // - Edit WS2812B_MAX_BRIGHTNESS in ws2812b_timer.h
 105:Core/Src/main.c ****   // - Range: 0-255 (0=off, 128=50%, 255=100%)
 106:Core/Src/main.c ****   // - Current setting: 128 (50% brightness)
 107:Core/Src/main.c ****   // ============================================================================
 108:Core/Src/main.c ****   WS2812B_Timer_Handle_t led_strip;
 109:Core/Src/main.c ****   WS2812B_Timer_Init(&led_strip, &htim2, TIM_CHANNEL_1, 8);
 110:Core/Src/main.c ****   
 111:Core/Src/main.c ****   // Initialize random seed for animations
 112:Core/Src/main.c ****   srand(HAL_GetTick());
 113:Core/Src/main.c ****   
 114:Core/Src/main.c ****   // Simple test: Turn all LEDs off initially
 115:Core/Src/main.c ****   WS2812B_Timer_ClearAll(&led_strip);
 116:Core/Src/main.c ****   WS2812B_Timer_Update(&led_strip);
 117:Core/Src/main.c ****   HAL_Delay(1000);  // Wait 1 second
 118:Core/Src/main.c **** 
 119:Core/Src/main.c ****   /* USER CODE END 2 */
 120:Core/Src/main.c **** 
 121:Core/Src/main.c ****   /* Infinite loop */
 122:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 123:Core/Src/main.c ****   while (1)
 124:Core/Src/main.c ****   {
 125:Core/Src/main.c ****     /* Toggle built-in LED state */
 126:Core/Src/main.c ****     HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
 127:Core/Src/main.c ****     
 128:Core/Src/main.c ****     // ============================================================================
 129:Core/Src/main.c ****     // WS2812B BRIGHTNESS DEBUG TEST
 130:Core/Src/main.c ****     // ============================================================================
 131:Core/Src/main.c ****     // Run the brightness test sequence
 132:Core/Src/main.c ****     WS2812B_Animation_Demo(&led_strip);
 133:Core/Src/main.c **** 
 134:Core/Src/main.c ****     // WS2812B_Animation_BrightnessTest(&led_strip);
 135:Core/Src/main.c ****     
 136:Core/Src/main.c ****     /* USER CODE END WHILE */
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 139:Core/Src/main.c ****   }
 140:Core/Src/main.c ****   /* USER CODE END 3 */
 141:Core/Src/main.c **** }
